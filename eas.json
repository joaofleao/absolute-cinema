{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "absolute-dev",
        "APP_NAME": "Absolute Dev",
        "IOS_BUNDLE_IDENTIFIER": "com.joaofleao.absolute-cinema.dev",
        "ANDROID_PACKAGE": "com.joaofleao.absolute_cinema.dev"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "absolute-dev",
        "APP_NAME": "Absolute Dev",
        "IOS_BUNDLE_IDENTIFIER": "com.joaofleao.absolute-cinema.dev",
        "ANDROID_PACKAGE": "com.joaofleao.absolute_cinema.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_NAME": "Absolute Cinema",
        "IOS_BUNDLE_IDENTIFIER": "com.joaofleao.absolute-cinema",
        "ANDROID_PACKAGE": "com.joaofleao.absolute_cinema"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_NAME": "Absolute Cinema",
        "IOS_BUNDLE_IDENTIFIER": "com.joaofleao.absolute-cinema",
        "ANDROID_PACKAGE": "com.joaofleao.absolute_cinema"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
